# Copy to a real env file in production and keep it private.
SECRET_KEY=replace-with-a-long-random-secret
SITE_URL=https://blog.example.com
DATABASE=/var/lib/the-journal/blog.db
UPLOAD_FOLDER=/var/lib/the-journal/uploads
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FLASK_DEBUG=false
LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW=900
MAX_UPLOAD_MB=8
POSTS_PER_PAGE=8
COMMENTS_PER_PAGE=25
